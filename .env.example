# ====================================================================
# Demand Prediction & Food Waste Reduction Platform - Environment Configuration
# ====================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development

# Supabase PostgreSQL Configuration
# If connecting to remote Supabase, supply the postgresql connection string:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# When blank or omitted, defaults smoothly to local SQLite database:
DATABASE_URL=sqlite:///./food_demand.db

# Supabase Project Credentials (used by backend service role operations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Server settings
PORT=8000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# NVIDIA NIM LLM Configuration (Free API Credits at https://build.nvidia.com)
# Ultra low latency models: meta/llama-3.2-11b-vision-instruct or mistralai/mistral-7b-instruct-v0.3
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

